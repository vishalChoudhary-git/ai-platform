# Example environment variables for AI Platform
# Copy this file to `.env` and fill real values before running `make dev`.

APP_NAME="AI Platform"
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_platform

# Cloudflare R2 (placeholders)
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name
R2_ENDPOINT_URL=https://your-account.r2.cloudflarestorage.com

# LLM & API keys (required)
LLAMA_CLOUD_API_KEY=your_llama_cloud_api_key
OPENAI_API_KEY=your_openai_api_key
TIER=your_tier

# Optional: other keys used by the app
# Add any other env vars referenced by your Settings model
