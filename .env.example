# Example environment variables for AI Platform
# Copy this file to `.env` and fill real values before running `make dev`.

APP_NAME="AI Platform"
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_platform

# Cloudflare R2
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name
R2_ENDPOINT_URL=https://your-account.r2.cloudflarestorage.com

# LLM & API keys
LLAMA_CLOUD_API_KEY=your_llama_cloud_api_key
OPENAI_API_KEY=your_openai_api_key
TIER=your_tier

# Optional platform settings
# OPENROUTER_API_KEY=your_openrouter_api_key
# RAG_LLM_MODEL=gpt-4.1-mini
# RAG_LLM_MAX_TOKENS=500
# RAG_LLM_TEMPERATURE=0.2
# REDIS_URL=redis://localhost:6379/0

# Expense decision notifications (development/testing)
EMAIL_ENABLED=false
EMAIL_SMTP_HOST=sandbox.smtp.mailtrap.io
EMAIL_SMTP_PORT=2525
EMAIL_SMTP_USERNAME=your_mailtrap_username
EMAIL_SMTP_PASSWORD=your_mailtrap_password
EMAIL_SMTP_USE_TLS=true
EMAIL_FROM_ADDRESS=no-reply@example.com
EMAIL_FROM_NAME="AI Platform"
